@model LibraryWeb.Models.BooksViewModel

@{
    ViewData["Title"] = "All Books";
    string[] categories = { "all", "bestsellers", "awardwinners", "newreleases", "newarrivals", "comingsoon", "deals" };
}

@if (TempData["NotificationMessage"] != null)
{
    <div class="alert alert-info fade-out" id="notificationMessage">
        @TempData["NotificationMessage"]
    </div>
    <script>
        setTimeout(() => {
            const msg = document.getElementById('notificationMessage');
            if (msg) {
                msg.style.transition = 'opacity 0.5s ease-out';
                msg.style.opacity = '0';
                setTimeout(() => msg.remove(), 500);
            }
        }, 3000);
    </script>
}

<div class="container">
    @* <h2 class="my-4 text-center">📚 Explore Our Library Collection</h2> *@

    <!-- Custom Filter Section -->
    <style>
        .alert {
            background-color: #dfe6e9;
            color: #2d3436;
            padding: 12px;
            margin-bottom: 20px;
            border-radius: 8px;
            font-size: 14px;
            text-align: center;
        }

        .filter-form {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1rem;
            background: #f4f4f4;
            padding: 1.5rem;
            border-radius: 10px;
            margin-bottom: 2rem;
        }

            .filter-form input,
            .filter-form select {
                padding: 0.5rem;
                border: 1px solid #ccc;
                border-radius: 6px;
                font-size: 0.95rem;
                width: 100%;
            }

            .filter-form button {
                padding: 0.5rem 1rem;
                border-radius: 6px;
                font-size: 0.95rem;
                background-color: #0077cc;
                color: white;
                border: none;
                width: auto;
                max-width: 200px;
                cursor: pointer;
                transition: background 0.3s ease;
            }

                .filter-form button:hover {
                    background-color: #005fa3;
                }

        .form-section-title {
            grid-column: 1 / -1;
            font-size: 1.1rem;
            font-weight: bold;
            margin-bottom: 0.5rem;
        }
    </style>


    <form method="post" asp-action="Index" class="filter-form">
        <!-- Text Inputs -->
        <div class="form-section-title">Search</div>
        <input type="text" name="searchQuery" placeholder="Title, ISBN, or description" />

        <input type="number" name="filterPriceMin" placeholder="Min Price" />
        <input type="number" name="filterPriceMax" placeholder="Max Price" />

        <!-- Dropdowns -->
        <div class="form-section-title">Apply Filters</div>
        <select name="filterAuthor">
            <option value="">All Authors</option>
            @foreach (var author in Model.Books.Select(b => b.Author).Distinct())
            {
                <option value="@author">@author</option>
            }
        </select>

        <select name="filterGenre">
            <option value="">All Genres</option>
            @foreach (var genre in Model.Books.Select(b => b.Genre).Distinct())
            {
                <option value="@genre">@genre</option>
            }
        </select>

        <select name="filterAvailability">
            <option value="">All Availability</option>
            <option value="1">Available</option>
            <option value="0">Out of Stock</option>
            <option value="2">Library-Only</option>
        </select>

        <select name="sortOrder">
            <option value="title">Sort by Title</option>
            <option value="publicationDate">Sort by Publication Date</option>
            <option value="price">Sort by Price</option>
            <option value="popularity">Sort by Popularity</option>
        </select>

        <!-- Submit Button -->
        <div style="grid-column: 1 / -1;">
            <button type="submit">Toggle Filters</button>
        </div>
    </form>


    <!-- Category Tabs -->
    <div class="text-center mb-4">
        @foreach (var cat in categories)
        {
            var label = cat
            .Replace("awardwinners", "🏆 Award Winners")
            .Replace("newreleases", "🆕 New Releases")
            .Replace("newarrivals", "📦 New Arrivals")
            .Replace("comingsoon", "⏳ Coming Soon")
            .Replace("bestsellers", "📈 Best Sellers")
            .Replace("deals", "💸 Deals")
            .Replace("all", "All");

            <form method="post" asp-action="Index" class="d-inline">
                <input type="hidden" name="category" value="@cat" />
                <input type="hidden" name="searchQuery" value="@Model.SearchQuery" />
                <input type="hidden" name="filterAuthor" value="@Model.FilterAuthor" />
                <input type="hidden" name="filterGenre" value="@Model.FilterGenre" />
                <input type="hidden" name="filterPriceMin" value="@Model.FilterPriceMin" />
                <input type="hidden" name="filterPriceMax" value="@Model.FilterPriceMax" />
                <input type="hidden" name="sortOrder" value="@Model.SortOrder" />
                <input type="hidden" name="filterAvailability" value="@Model.FilterAvailability" />
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <button type="submit" class="btn btn-outline-secondary m-1 @(Model.Category?.Equals(cat, StringComparison.OrdinalIgnoreCase) == true ? "active" : "")">
                    @label
                </button>
            </form>
        }
    </div>

    <!-- Books Table -->
    <div class="table-responsive">
        <table class="table table-striped">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Genre</th>
                    <th>Price</th>
                    <th>Availability</th>
                    <th>Rating</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model.Books)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>@book.Genre</td>
                        <td>$@book.Price</td>
                        <td>
                            @{
                                var availabilityText = book.InStock switch
                                {
                                    0 => "Out of Stock",
                                    1 => "Yes",
                                    2 => "Library-Only"
                                };
                            }
                            @availabilityText
                        </td>
                        <td>@book.Rating ⭐</td>
                        <td>
                            @if (User.Identity.IsAuthenticated)
                            {
                                <div class="d-flex flex-row gap-1">
                                    <form method="post" asp-controller="Books" asp-action="Bookmark">
                                        <input type="hidden" name="bookId" value="@book.Id" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">🔖 Bookmark</button>
                                    </form>

                                    @if (book.InStock == 1)
                                    {
                                        <form method="post" asp-controller="Cart" asp-action="AddToCart">
                                            <input type="hidden" name="bookId" value="@book.Id" />
                                            <button type="submit" class="btn btn-outline-success btn-sm">🛒 Add to Cart</button>
                                        </form>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">Login to Bookmark or Buy</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                    <form method="post" asp-controller="Books" asp-action="Index">
                        <input type="hidden" name="searchQuery" value="@Model.SearchQuery" />
                        <input type="hidden" name="filterAuthor" value="@Model.FilterAuthor" />
                        <input type="hidden" name="filterGenre" value="@Model.FilterGenre" />
                        <input type="hidden" name="filterPriceMin" value="@Model.FilterPriceMin" />
                        <input type="hidden" name="filterPriceMax" value="@Model.FilterPriceMax" />
                        <input type="hidden" name="sortOrder" value="@Model.SortOrder" />
                        <input type="hidden" name="filterAvailability" value="@Model.FilterAvailability" />
                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                        <input type="hidden" name="category" value="@Model.Category" />
                        <button type="submit" name="page" value="@i" class="page-link">
                            @i
                        </button>
                    </form>
                </li>
            }
        </ul>
    </nav>
</div>
