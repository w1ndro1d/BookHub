@model LibraryWeb.Models.BooksViewModel

@{
    ViewData["Title"] = "All Books";
}

<h1>Available Books 📚</h1>

<!-- Filter and Sorting Controls -->
<form method="post" asp-action="Index">
    <!-- Search by Title, ISBN, or Description -->
    <input type="text" name="searchQuery" placeholder="Search by title, ISBN, or description" class="form-control" />

    <!-- Filter by Author -->
    <select name="filterAuthor" class="form-control">
        <option value="">All Authors</option>
        @foreach (var author in Model.Books.Select(b => b.Author).Distinct())
        {
            <option value="@author">@author</option>
        }
    </select>

    <!-- Filter by Genre -->
    <select name="filterGenre" class="form-control">
        <option value="">All Genres</option>
        @foreach (var genre in Model.Books.Select(b => b.Genre).Distinct())
        {
            <option value="@genre">@genre</option>
        }
    </select>

    <!-- Filter by Price Range -->
    <input type="number" name="filterPriceMin" placeholder="Min Price" class="form-control" />
    <input type="number" name="filterPriceMax" placeholder="Max Price" class="form-control" />

    <!-- Filter by Availability -->
    <select name="filterAvailability" class="form-control">
        <option value="">Availability - All</option>
        <option value=1>Available</option>
        <option value=0>Out of Stock</option>
        <option value=2>Library-Only</option>
    </select>

    <!-- Sort by -->
    <select name="sortOrder" class="form-control">
        <option value="title">Sort by Title</option>
        <option value="publicationDate">Sort by Publication Date</option>
        <option value="price">Sort by Price</option>
        <option value="popularity">Sort by Popularity</option>
    </select>

    <button type="submit" class="btn btn-primary">Apply Filters</button>
</form>

<!-- Book Table -->
<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Genre</th>
            <th>Price</th>
            <th>Available</th>
            <th>Rating</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model.Books)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.Genre</td>
                <td>$@book.Price</td>
                <td>
                    @{
                        var availabilityText = book.InStock switch
                        {
                            0 => "Out of Stock",
                            1 => "Yes",
                            2 => "Library-Only"
                        };
                    }
                    @availabilityText
                </td>
                <td>@book.Rating ⭐</td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination Controls -->
<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                <form method="post" asp-controller="Books" asp-action="Index">
                    <input type="hidden" name="searchQuery" value="@Model.SearchQuery" />
                    <input type="hidden" name="filterAuthor" value="@Model.FilterAuthor" />
                    <input type="hidden" name="filterGenre" value="@Model.FilterGenre" />
                    <input type="hidden" name="filterPriceMin" value="@Model.FilterPriceMin" />
                    <input type="hidden" name="filterPriceMax" value="@Model.FilterPriceMax" />
                    <input type="hidden" name="sortOrder" value="@Model.SortOrder" />
                    <input type="hidden" name="filterAvailability" value="@Model.FilterAvailability" />
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                    <button type="submit" name="page" value="@i" class="page-link">
                        @i
                    </button>
                </form>
            </li>
        }
    </ul>
</nav>

